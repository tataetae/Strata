HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:8082/v1
HINDSIGHT_API_LLM_MODEL=qwen3.8-flash-next-iq4_xs
HINDSIGHT_API_LLM_API_KEY=<same as /home/clara/.hermes/config.yaml: providers.strata.api_key>
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_LLM_TIMEOUT=60000
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_WORKER_ID=hermes-linux
HINDSIGHT_API_ENABLE_BANK_LLM_HEALTH=true

# --- Strata slot etiquette (2026-10-28) -------------------------------------
# Strata serves 3 slots. Hindsight keeps 1 so interactive use always has room.
HINDSIGHT_API_ADMISSION_RETAIN_MAX_IN_FLIGHT=1
HINDSIGHT_API_ADMISSION_REFLECT_MAX_IN_FLIGHT=1
HINDSIGHT_API_CONSOLIDATION_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_CONSOLIDATION_LLM_PARALLELISM=1
HINDSIGHT_API_CONSOLIDATION_LLM_TIMEOUT=600
HINDSIGHT_API_CONSOLIDATION_WALL_TIMEOUT=1800
# Without a cap Strata fills the whole 262k window with reasoning tokens.
HINDSIGHT_API_CONSOLIDATION_MAX_COMPLETION_TOKENS=16384
HINDSIGHT_API_REFLECT_MAX_COMPLETION_TOKENS=16384
HINDSIGHT_API_MENTAL_MODEL_REFRESH_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_MODEL_INIT_TIMEOUT=3600
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=2
HINDSIGHT_API_REFLECT_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_LLM_REASONING_EFFORT=none
HINDSIGHT_API_REFLECT_WALL_TIMEOUT=3600
